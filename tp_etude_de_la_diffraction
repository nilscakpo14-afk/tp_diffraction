print(f"l'ecart relatif de a par rapport b (distance entre les deux fentes) la valeur theorique est {functions.relative_difference(b_th, functions.uncertainty_A(b)[0]):.3f}")

# 3- diffraction par des reseaux
# a- diffraction par transmission

d = 0.8 # distance entre deux ordres de diffraction en cm

# demontrons que i = lambda*D/c (voir cahier de TP)

c = 7.91 *1e-5 # pas du réseau en m

n = 1/c *1e-3 # nombre de traits par millimetre
delta_n = 2 # traits par millimetres (details du calcul: voir photo)

print(f"le nombre n de traits par millimetre est {n:.0f} +/- {delta_n:.0f}")

# b- diffraction par reflexion

# on constate que les reflexions correspondants aux differents ordres de diffraction sont assez eloignés sur l'ecran ce qui suggère un angle theta grand. 

# on ne peut donc pas faire l'approximation sur theta

# considérons les pas de réseaux uniquement entre l'ordre 0 et l'ordre 1

i_cd = 4.2*1e-2 # distances sur l'ecran entre les ordres O et 1 en m
i_dvd = 15.7*1e-2 # distance sur l'écran entre les ordre 0 et 1 en m
D = 10*1e-2 # en m

# c = lambdaa/sin(theta) et theta = arctan(i/D)

c_cd = lambdaa/m.sin(m.atan(i_cd/D))*1e6 # pas du reseau de cd en micrometre
c_dvd = lambdaa/m.sin(m.atan(i_dvd/D))*1e6 # pas du reaseau de dvd en micrometres

# comparaison des rapports c_cd/c_dvd obtenu graphiquement et experimentalement

c_cd_gr = 1.5 # en micrometres
c_dvd_gr = 0.7 # en micrometres

rapport_gr = c_cd_gr/c_dvd_gr
rapport_exp = c_cd/c_dvd

print(f"le rapport c_cd/c_dvd theorique est {rapport_gr:.3f}")
print(f"le rapport c_cd/c_dvd experimental est {rapport_exp:.3f}")
print(f"l'erreur relative du rapport c_cd/c_dvd par rapport a la theorie est {functions.relative_difference(rapport_gr, rapport_exp):.3f}")

