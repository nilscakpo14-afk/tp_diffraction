# II. Vérification experimentale

# a- Diffraction par une fente et deux fentes

D = 1.00 # Distance entre l'objet diffractant et l'écran (en m)
lambdaa = 6.328e-7 #Longueur d'onde du laser helium-neon (en m)
L = 1e-2*np.array([1.8, 3.7, 5.6, 7.5, 9.5, 11.3]) # longueur mesurée (en m) 
N = np.array([2, 4, 6, 8, 10, 12]) # nombre d'interfrages pour une longueur L

ia = L/N # interfrange associée à a (en m)
a = lambdaa*D/ia*1e6 # largeur de la fente (en micrometres)

print(f"la largeur de la fente a est : {functions.uncertainty_A(a)[0]:.3f} +/- {functions.uncertainty_A(a)[2]:.2f} micrometres")

N = np.array([15, 31, 45, 59, 63, 77]) # nombre d'interfrange associé à b pour une longuer L 

ib = L/N # interfrange associé à b en m
b = lambdaa*D/ib*1e3 # distance entre les fentes en millimetres (mm)

print(f"la distance b entre les fentes est {functions.uncertainty_A(b)[0]:.3f} +/- {functions.uncertainty_A(b)[2]:.3f}")

